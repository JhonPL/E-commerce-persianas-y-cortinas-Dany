# Add these entries to backend/.env. Use one internal token across all services.
CATALOGO_SERVICE_URL=http://127.0.0.1:8001/api/v1/catalogo
CATALOGO_SERVICE_INTERNAL_URL=http://127.0.0.1:8001/api/internal/catalogo
CATALOGO_SERVICE_TIMEOUT_SECONDS=5
CART_SERVICE_URL=http://127.0.0.1:8002/api/v1/carrito
CART_SERVICE_INTERNAL_URL=http://127.0.0.1:8002/api/internal/carrito
CART_SERVICE_TIMEOUT_SECONDS=5
ORDERS_SERVICE_URL=http://127.0.0.1:8003
ORDERS_SERVICE_TIMEOUT_SECONDS=5
IDENTITY_SERVICE_URL=http://127.0.0.1:8004
IDENTITY_SERVICE_TIMEOUT_SECONDS=5
NOTIFICATION_SERVICE_URL=http://127.0.0.1:8005
NOTIFICATION_SERVICE_TIMEOUT_SECONDS=5
INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-shared-token
PAYMENTS_SERVICE_URL=http://127.0.0.1:8007/api/v1/payments
PAYMENTS_SERVICE_TIMEOUT_SECONDS=10
