DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

CATALOGO_DB_NAME=catalogo
CATALOGO_DB_USER=postgres
CATALOGO_DB_PASSWORD=replace-me
CATALOGO_DB_HOST=localhost
CATALOGO_DB_PORT=5432

# URL of the still-monolithic identity API endpoint that validates incoming JWTs.
AUTH_SERVICE_URL=http://127.0.0.1:8004/api/v1/auth/me/

# Must match backend INTERNAL_SERVICE_TOKEN.
INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-shared-token

# Still-monolithic endpoint used to preserve product-delete rules for cart/orders.

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
